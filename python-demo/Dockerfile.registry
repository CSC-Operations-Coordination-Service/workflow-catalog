# syntax=docker/dockerfile:1
#
# Mode 2 — "registry": download the package that was published to the Nexus
# PyPI repository and install it by version. No build context / wheel needed.
#
# The index URL and the credentials are passed as two BuildKit secrets, so
# neither is baked into an image layer or `docker history`.
#
FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Exact version to install, e.g. "0.1.2". Provided by the pipeline.
ARG PACKAGE_VERSION

WORKDIR /app

# `pip_index_url` secret = Nexus PyPI simple index, credential-free, e.g.
#   http://nexus.example.com:8081/repository/pypi-prod-group/simple
# `netrc` secret carries the credentials, mounted where pip looks for them.
# --no-input: without a TTY a 401 would otherwise end in an opaque EOFError
# from pip's credential prompt instead of a readable auth error.
RUN --mount=type=secret,id=pip_index_url \
    --mount=type=secret,id=netrc,target=/root/.netrc \
    set -eu; \
    index_url="$(tr -d '\r\n' < /run/secrets/pip_index_url)"; \
    hostpart="${index_url#*://}"; hostpart="${hostpart%%/*}"; \
    index_host="${hostpart##*@}"; index_host="${index_host%%:*}"; \
    pip install --no-cache-dir --no-input \
        --index-url "$index_url" \
        --trusted-host "$index_host" \
        "python-demo==${PACKAGE_VERSION}"

RUN useradd --create-home --uid 10001 appuser
USER appuser

ENTRYPOINT ["python-demo"]
CMD ["10"]
